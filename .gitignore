# Python
__pycache__/
*.pyc
*.pyo

# ROS2 colcon build artifacts (정상적으로는 Docker named volume에만 생기지만,
# 혹시 호스트에서 직접 빌드했을 경우를 대비)
build/
install/
log/

# 런타임 산출물 (구조는 유지하되 실제 데이터는 커밋하지 않음)
data/*.db
maps/*.pgm
maps/*.yaml
bags/*.db3
!**/.gitkeep

# OS junk
.DS_Store
Thumbs.db

# 에디터
.vscode/
*.swp

# Flutter/Dart는 app/lidar_mapper_app/.gitignore 에서 자체 처리
